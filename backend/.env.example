# Copy to .env and fill in for your local environment. Do not commit .env.
#
# Milestone 2 has no LLM/external-provider integration, so there are no
# API keys here yet. A future milestone that introduces a provider will
# extend this file at that time.

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/TEST_DATABASE

# Milestone 5 (backend/src/app/generation/): only required to run the real
# GeminiAnswerGenerator (live API, or app/generation/evaluate.py). The
# entire pytest suite uses FakeAnswerGenerator and never reads this.
GEMINI_API_KEY=
