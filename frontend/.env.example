# Copy to .env.local for local development. Do not commit .env.local.
#
# Server-only: read by src/lib/api/backend.ts and never exposed to the
# browser (deliberately not NEXT_PUBLIC_*). Every request to FastAPI is
# made from Next.js server code (Server Components, Server Actions, or a
# Route Handler under src/app/api/) — the browser never talks to FastAPI
# directly, so no CORS configuration is needed on the backend either.
BACKEND_URL=http://localhost:8000
